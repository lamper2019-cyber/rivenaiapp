generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  COACH
}

enum Phase {
  PHASE_1
  PHASE_2
  PHASE_3
  PHASE_4
}

enum CycleStatus {
  REGULAR
  PERIMENOPAUSAL
  MENOPAUSAL
  NA
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MenuAdherence {
  YES
  MOSTLY
  NOT_REALLY
}

enum CheckInCycle {
  PRE_PERIOD
  ON_PERIOD
  MID_CYCLE
  POST_PERIOD
  NA
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMessageKind {
  AI
  COACH
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe billing. stripeCustomerId is the durable Stripe customer record
  // (one per User, created lazily on first Checkout). subscriptionStatus
  // mirrors Stripe values — "trialing" | "active" | "past_due" | "canceled"
  // | "incomplete" | "incomplete_expired" | "unpaid" — plus our own
  // "comped" value for beta clients who get the app free for life.
  stripeCustomerId             String?   @unique
  subscriptionStatus           String?
  subscriptionCurrentPeriodEnd DateTime?

  // Throttle for peer cheer pushes. When a 🌹 lands and cheerLastPushAt
  // is null or > 10 min ago, send a push and update this timestamp.
  // Subsequent cheers inside the same 10-min window skip the push to
  // avoid buzz-buzz-buzz — the dashboard card surfaces them instead.
  cheerLastPushAt              DateTime?

  // Falling-roses ceremony state. The animated overlay fires on
  // /dashboard whenever there are CheerReactions newer than this
  // timestamp. We bump it to now() after she sits through (or skips)
  // the animation. firstCheerCeremonySeenAt records when the welcome
  // banner played — fires once per user, ever; subsequent ceremonies
  // skip straight to the rose drop.
  cheersLastSeenAt             DateTime?
  firstCheerCeremonySeenAt     DateTime?

  // Presence: stamped every time she opens /dashboard. The
  // PresenceIndicator surfaces "Tracy and Adrienne are in RIVEN
  // right now" by querying active clients with lastDashboardSeenAt
  // within the last 15 min. Cheap; doesn't drive any business logic.
  lastDashboardSeenAt          DateTime?

  profile           Profile?
  mealLogs          MealLog[]
  dailyTotals       DailyTotals[]
  weeklyCheckIns    WeeklyCheckIn[]
  contentSubmissions ContentSubmission[]
  chatMessages      ChatMessage[]      @relation("ChatRecipient")
  sentChatMessages  ChatMessage[]      @relation("ChatSender")
  pushSubscriptions PushSubscription[]
  cheersReceived   CheerReaction[]    @relation("CheersReceived")
  cheersSent       CheerReaction[]    @relation("CheersSent")
  sundayAnswers    SundayPromptAnswer[]
  sundayReactions  SundayPromptReaction[]
  dailyMoods       DailyMood[]
  pendingAiReplies PendingAiReply[]
  voiceMoments     VoiceMoment[]
}

model Profile {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  age                 Int
  heightInches        Float
  startWeight         Float
  goalWeight          Float
  currentWeight       Float
  activityLevel       ActivityLevel
  cycleStatus         CycleStatus
  phase               Phase         @default(PHASE_1)

  // Calculated targets (Mifflin-St Jeor + RIVEN protocol)
  maintenanceCalories Int
  cutCalories         Int
  weeklyBudget        Int
  proteinFloor        Int

  onboardedAt         DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Post-profile tutorial walkthrough. 0–4 = currently on that slide,
  // 5+ = completed (or skipped). Default 5 so existing rows from before
  // this column existed don't get marched through the tutorial; new
  // profile rows from onboarding/actions.ts explicitly set tutorialStep: 0.
  tutorialStep        Int           @default(5)

  // Duolingo-style streak protection. Each client starts with one freeze;
  // when she misses a day mid-streak the engine can spend a freeze to keep
  // the streak alive instead of resetting it to zero. v1 of this feature
  // ships the foundation (column + UI visibility); the auto-spend logic
  // in sean-messages lands in a follow-up so the behavior can be tested
  // in isolation before going live on the cron path.
  streakFreezesAvailable Int        @default(1)

  // Per-day-of-week calorie schedule. NULL = use the flat cutCalories
  // for every day (default behavior for almost every client). When set,
  // shape is { Sun, Mon, Tue, Wed, Thu, Fri, Sat → number }, keyed by
  // Central-time day-of-week label. Used for calorie-cycling protocols
  // (rest / lift / refeed days) on advanced clients like Rora. The
  // helper in src/lib/calorie-schedule.ts handles parse + fallback.
  dailyCalorieSchedule   Json?

  // Client-controlled "smooth my week" lever (calorie banking). When ON,
  // today's target = cutCalories + whatever she banked/owed yesterday,
  // replayed from Sunday and clamped to cutCalories ± 600. Undereat one
  // day → the leftover rolls to the next day; overeat → it's docked the
  // next day. Protein floor never moves. Defaults OFF so every existing
  // client is unaffected. When ON it overrides dailyCalorieSchedule.
  // Logic lives in src/lib/calorie-schedule.ts (pure) + calorie-banking.ts
  // (DB-aware resolver).
  calorieBankingEnabled  Boolean       @default(false)
}

// Peer-to-peer cheer reactions. When a client is having a hard day (no log
// 24h+, streak broken, way-over target), other clients see a soft prompt
// to send her a 🌹. Schema is open-ended so we can add more reaction types
// later (today: ROSE only). The unique constraint on (recipient, sender,
// context) prevents a sender from spamming the same trigger.
model CheerReaction {
  id              String   @id @default(cuid())
  recipientUserId String
  recipient       User     @relation("CheersReceived", fields: [recipientUserId], references: [id], onDelete: Cascade)
  senderUserId    String
  sender          User     @relation("CheersSent",     fields: [senderUserId],    references: [id], onDelete: Cascade)
  // "no_log_24h" | "broke_streak" | "way_over_target" | "manual"
  context         String
  createdAt       DateTime @default(now())

  @@unique([recipientUserId, senderUserId, context])
  @@index([recipientUserId, createdAt])
  @@index([senderUserId])
}

model MealLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  description String
  // 3-5 word AI-generated label for compact display ("Eggs, bacon, toast").
  // Nullable for legacy rows logged before this field existed; new rows always
  // get one from Claude's structured output.
  shortName   String?
  calories    Int
  protein     Int
  fat         Int
  carbs       Int
  aiResponse  String   @db.Text

  // AI-extracted per-item breakdown. Each item is { name, calories, protein,
  // fat, carbs }. Lets the UI render individual food chips (Big Mac, fries,
  // chips) instead of forcing the whole combo as a single tappable unit.
  // Nullable for legacy rows; new logs always include at least one item.
  items       Json?

  // Heads-up flag for ultra-processed / refined / seed-oil / sugary content.
  // The "why" is in flagReason — surfaced in the response card to teach,
  // not preach.
  processedFlag Boolean @default(false)
  flagReason    String? @db.Text

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model DailyTotals {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime @db.Date
  totalCalories Int      @default(0)
  totalProtein  Int      @default(0)
  totalFat      Int      @default(0)
  totalCarbs    Int      @default(0)
  totalSteps    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WeeklyCheckIn {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart         DateTime       @db.Date
  weight            Float
  waist             Float
  photoFrontUrl     String?
  photoSideUrl      String?
  menuAdherence     MenuAdherence
  sleepAvg          Float
  cycleStatus       CheckInCycle
  stress            Int
  winsAndStruggles  String         @db.Text

  createdAt         DateTime       @default(now())

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model ContentSubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  week       DateTime @db.Date
  promptText String
  videoUrl   String?
  photoUrl   String?

  createdAt  DateTime @default(now())

  @@index([userId, week])
}

model ChatMessage {
  id        String   @id @default(cuid())

  // Whose chat thread this message belongs to (always the client).
  userId    String
  user      User     @relation("ChatRecipient", fields: [userId], references: [id], onDelete: Cascade)

  role      ChatRole
  // AI = generated by Claude. COACH = written by Sean from the coach dashboard.
  // USER messages are always AI-bound (the client typing into the AI chat).
  kind      ChatMessageKind @default(AI)

  // Only set for kind = COACH messages — Sean's User.id.
  senderUserId String?
  sender       User?   @relation("ChatSender", fields: [senderUserId], references: [id])

  content   String   @db.Text
  // Public R2 URLs for images attached to USER messages, passed to Claude vision.
  imageUrls String[] @default([])

  // Proactive-messaging category. Null for normal chat / hand-written coach
  // messages. Set to a category string like "rhythm_wed_pm" or
  // "behavioral_24h" when the Sean-messages tick fires a templated nudge.
  // Used for cooldown enforcement (same category can't fire twice in 48h)
  // and daily-cap counting (max 3 proactive sends per client per day).
  category  String?

  // Marks COACH messages that were generated by AI as an auto-reply on
  // behalf of Sean (vs ones Sean wrote himself from the coach dashboard).
  // Invisible to clients — they see all COACH messages as just "from Sean."
  // The coach-side messaging dashboard uses this to show Sean which of
  // her recent replies he authored vs which were auto-replies he might
  // want to follow up on.
  aiGenerated Boolean  @default(false)

  // Voice moments: when Sean records a 60-second voice memo for a
  // milestone (currently: every monthly check-in submission), the
  // audio file URL + duration land here. The chat bubble for messages
  // with audioUrl set renders an HTML5 audio player instead of the
  // plain-text bubble. Real Sean only — never set by AI auto-replies.
  audioUrl        String?
  audioDurationSec Int?

  // Tap-reply chips for Sean's proactive daily check-ins. Shape:
  // [{ label: "walk", value: "walk" }, ...]. When set + chipsRepliedAt
  // is null, the chat bubble renders the chip buttons below the
  // message text. Tapping a chip fires sendToSean with the chip's
  // value, persists her USER reply, schedules the AI auto-reply,
  // and stamps chipsRepliedAt on this row so the chips collapse.
  chipOptions     Json?
  chipsRepliedAt  DateTime?

  createdAt DateTime @default(now())

  // Back-relation: if this message was delivered as part of a voice
  // moment, this is the link back to the queue row. Used for the
  // coach dashboard to tell which messages came from the voice queue.
  voiceMoment VoiceMoment? @relation("VoiceMomentMessage")

  @@index([userId, createdAt])
  @@index([senderUserId])
  @@index([userId, category, createdAt])
}

// Queue table for delayed AI auto-replies on the unified "Sean" thread.
// When a client sends Sean a message, we insert a row here with a
// scheduledFor timestamp randomized in the 1.5-15 minute range (skewed
// toward 1-5 min). The /api/cron/process-ai-replies route polls every
// minute, generates a Sean-voice reply via Claude, inserts it as a
// COACH ChatMessage with aiGenerated=true, and marks status="sent."
//
// Real Sean can still write replies manually from the coach dashboard
// — those go straight into ChatMessage with aiGenerated=false.
model PendingAiReply {
  id              String   @id @default(cuid())
  // Client whose thread this reply belongs to.
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The user-side ChatMessage that triggered this reply. Used for
  // building the Claude prompt context — we read recent history anyway,
  // but keeping the trigger explicit makes debugging easier.
  triggerMessageId String
  // When the cron should fire this reply. Stored as UTC instant; the
  // cron picks up anything with scheduledFor <= now() AND status="pending".
  scheduledFor    DateTime
  // "pending" | "sent" | "failed" | "cancelled" — rows are kept after
  // firing for analytics + debugging. Cancelled rows are queued
  // replies Sean overrode by writing back himself from the coach
  // messaging dashboard. Sent/failed/cancelled rows can be purged later.
  status          String   @default("pending")
  // Populated by the cron route on send or failure.
  sentAt          DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Web Push API fields. The endpoint is unique per browser+device.
  endpoint  String   @unique
  p256dh    String   // base64url-encoded ECDH public key
  auth      String   // base64url-encoded auth secret
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Lead from the /quiz funnel. Captured before sign-up — we hold the
// answers + computed score + Q14 budget tier so the results page can
// route to the right CTA and Sean can email/segment leads later.
// convertedToUserId is loosely linked (no FK relation) so deleting a
// User doesn't cascade and lose marketing history.
model Lead {
  id                String   @id @default(cuid())

  // Captured on the contact step before questions start.
  firstName         String
  email             String
  phone             String?

  // Auto-captured at submit time.
  ipAddress         String?
  country           String?

  // Full answer set. Shape: Record<string, string | string[] | boolean>
  // Keyed by question id (q1..q15). q1–q10 are "yes"/"no", q11–q14 are
  // option keys, q15 is free text. Schema enforced by zod at the API edge.
  answers           Json

  // Derived once at submit. Stored so the results page doesn't recompute
  // and Sean can sort/filter the dashboard later without re-scoring.
  score             Int      // 0–10, count of "yes" in q1–q10
  budgetTier        String   // FREE | APP | COACH | DONE_FOR_YOU — from q14

  // If she later signs up, we stamp her User.id here so Sean can see
  // who converted. Plain String (no FK) on purpose — see model comment.
  convertedToUserId String?

  createdAt         DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([budgetTier, score])
}

// Sunday Daily Ritual — once-a-week shared reflection prompt for the
// community. Sean writes the question (via /coach/profile editor); on
// Sundays it appears at the top of every active client's dashboard with
// an answer composer and the rest of the room's answers below.
//
// "Open Sunday" semantics per Sean's pick: answers + reactions are
// accepted any time the local day is Sunday in Central. Outside that
// window the surface renders as replay-only.

model SundayPrompt {
  id        String   @id @default(cuid())
  // ISO-week Monday — one SundayPrompt per week. The Sunday surface looks
  // up this week's prompt by this key.
  weekStart DateTime @unique
  question  String
  // Format kind. "pulse" = 3-tap bar poll, "this_or_that" = binary card,
  // "is_this_you" = relatable + 3 confession reactions, "open" = legacy
  // free-text answer (historical only — new prompts auto-rotate through
  // the three tap formats). The coach editor can override the auto-picked
  // kind per week.
  kind      String   @default("pulse")
  // Options for tap formats. Shape depends on kind:
  //   pulse:        [{ key: "discipline", label: "discipline" }, ...]  (3 entries)
  //   this_or_that: [{ key: "left", label: "I'll start Monday" }, ...] (2 entries)
  //   is_this_you:  [{ key: "me", label: "😤 me" }, ...]               (3 entries)
  //   open:         null (use SundayPromptAnswer.body)
  options   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  answers   SundayPromptAnswer[]
}

model SundayPromptAnswer {
  id        String   @id @default(cuid())
  promptId  String
  prompt    SundayPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Option key she tapped for tap-format prompts (pulse / this_or_that /
  // is_this_you). Null on legacy "open" answers, which use body instead.
  choice    String?
  // Free-text answer. Nullable now — only legacy "open" prompts populate
  // this field. New tap-format answers leave body null.
  body      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reactions SundayPromptReaction[]

  @@unique([promptId, userId])
  @@index([promptId, createdAt])
}

model SundayPromptReaction {
  id        String   @id @default(cuid())
  answerId  String
  answer    SundayPromptAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "rose" 🌹 (peaceful) | "strong" 💪 (encouragement) | "leaf" 🌿 (steady)
  kind      String
  createdAt DateTime @default(now())

  @@unique([answerId, userId, kind])
  @@index([answerId])
}

// Voice moments — Sean's personal voice memos triggered by client
// milestones. Currently only fires on monthly check-in submission;
// future triggers (streak, goal weight) live as separate triggerKind
// values without enum migration.
//
// Lifecycle:
//   queued    → Created when the trigger event fires (e.g. monthly
//               check-in submitted). Shows up in the coach voice
//               queue for Sean to record.
//   recorded  → Sean recorded + sent. audioUrl + deliveredMessageId
//               are set. Client sees the audio bubble in the thread.
//   skipped   → Sean opted not to record for this trigger. Doesn't
//               surface to the client; tracked so the queue clears.
model VoiceMoment {
  id              String   @id @default(cuid())
  recipientUserId String
  recipient       User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  // What kind of milestone triggered this prompt. Currently only
  // "monthly_check_in" is wired; future kinds can be added without
  // schema changes.
  triggerKind     String
  // Specific event id (e.g. WeeklyCheckIn.id for monthly_check_in).
  // The unique constraint on (recipient, kind, source) means re-
  // submitting the same check-in doesn't double-queue.
  triggerSourceId String
  status          String   @default("queued")
  audioUrl        String?
  durationSec     Int?
  // The delivered ChatMessage row. Set when status flips to "recorded";
  // links the queue entry to the audio bubble the client sees.
  deliveredMessageId String?  @unique
  deliveredMessage   ChatMessage? @relation("VoiceMomentMessage", fields: [deliveredMessageId], references: [id])

  createdAt   DateTime @default(now())
  recordedAt  DateTime?

  @@unique([recipientUserId, triggerKind, triggerSourceId])
  @@index([status, createdAt])
}

// Daily mood ribbon — one-tap-a-day community pulse. Each client taps one
// of four moods (tired / blah / good / fire) and immediately sees how the
// rest of the room is feeling. Bucketed by Central-time day so the count
// resets at midnight CT. (userId, centralDate) is unique — re-tapping
// inside the same day updates her mood instead of stacking rows.
model DailyMood {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "tired" 😤 | "blah" 🥱 | "good" 🙂 | "fire" 🔥
  mood        String
  // Optional second-tap follow-up. After she picks a mood she gets a
  // soft "what's making it ___?" question with three options: "sleep"
  // | "food" | "stress". Null = she skipped the follow-up (or it's an
  // 'okay' day she didn't elaborate on). Drives client + coach mood-
  // pattern dashboards.
  cause       String?
  centralDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, centralDate])
  @@index([centralDate])
}
