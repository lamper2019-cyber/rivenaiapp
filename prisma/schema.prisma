generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  COACH
}

enum Phase {
  PHASE_1
  PHASE_2
  PHASE_3
  PHASE_4
}

enum CycleStatus {
  REGULAR
  PERIMENOPAUSAL
  MENOPAUSAL
  NA
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MenuAdherence {
  YES
  MOSTLY
  NOT_REALLY
}

enum CheckInCycle {
  PRE_PERIOD
  ON_PERIOD
  MID_CYCLE
  POST_PERIOD
  NA
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMessageKind {
  AI
  COACH
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile           Profile?
  mealLogs          MealLog[]
  dailyTotals       DailyTotals[]
  weeklyCheckIns    WeeklyCheckIn[]
  contentSubmissions ContentSubmission[]
  chatMessages      ChatMessage[]      @relation("ChatRecipient")
  sentChatMessages  ChatMessage[]      @relation("ChatSender")
  pushSubscriptions PushSubscription[]
}

model Profile {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  age                 Int
  heightInches        Float
  startWeight         Float
  goalWeight          Float
  currentWeight       Float
  activityLevel       ActivityLevel
  cycleStatus         CycleStatus
  phase               Phase         @default(PHASE_1)

  // Calculated targets (Mifflin-St Jeor + RIVEN protocol)
  maintenanceCalories Int
  cutCalories         Int
  weeklyBudget        Int
  proteinFloor        Int

  onboardedAt         DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Post-profile tutorial walkthrough. 0–4 = currently on that slide,
  // 5+ = completed (or skipped). Default 5 so existing rows from before
  // this column existed don't get marched through the tutorial; new
  // profile rows from onboarding/actions.ts explicitly set tutorialStep: 0.
  tutorialStep        Int           @default(5)
}

model MealLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  description String
  calories    Int
  protein     Int
  fat         Int
  carbs       Int
  aiResponse  String   @db.Text

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model DailyTotals {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime @db.Date
  totalCalories Int      @default(0)
  totalProtein  Int      @default(0)
  totalFat      Int      @default(0)
  totalCarbs    Int      @default(0)
  totalSteps    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WeeklyCheckIn {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart         DateTime       @db.Date
  weight            Float
  waist             Float
  photoFrontUrl     String?
  photoSideUrl      String?
  menuAdherence     MenuAdherence
  sleepAvg          Float
  cycleStatus       CheckInCycle
  stress            Int
  winsAndStruggles  String         @db.Text

  createdAt         DateTime       @default(now())

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model ContentSubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  week       DateTime @db.Date
  promptText String
  videoUrl   String?
  photoUrl   String?

  createdAt  DateTime @default(now())

  @@index([userId, week])
}

model ChatMessage {
  id        String   @id @default(cuid())

  // Whose chat thread this message belongs to (always the client).
  userId    String
  user      User     @relation("ChatRecipient", fields: [userId], references: [id], onDelete: Cascade)

  role      ChatRole
  // AI = generated by Claude. COACH = written by Sean from the coach dashboard.
  // USER messages are always AI-bound (the client typing into the AI chat).
  kind      ChatMessageKind @default(AI)

  // Only set for kind = COACH messages — Sean's User.id.
  senderUserId String?
  sender       User?   @relation("ChatSender", fields: [senderUserId], references: [id])

  content   String   @db.Text
  // Public R2 URLs for images attached to USER messages, passed to Claude vision.
  imageUrls String[] @default([])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([senderUserId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Web Push API fields. The endpoint is unique per browser+device.
  endpoint  String   @unique
  p256dh    String   // base64url-encoded ECDH public key
  auth      String   // base64url-encoded auth secret
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
