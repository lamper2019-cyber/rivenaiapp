generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  COACH
}

enum Phase {
  PHASE_1
  PHASE_2
  PHASE_3
  PHASE_4
}

enum CycleStatus {
  REGULAR
  PERIMENOPAUSAL
  MENOPAUSAL
  NA
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MenuAdherence {
  YES
  MOSTLY
  NOT_REALLY
}

enum CheckInCycle {
  PRE_PERIOD
  ON_PERIOD
  MID_CYCLE
  POST_PERIOD
  NA
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMessageKind {
  AI
  COACH
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe billing. stripeCustomerId is the durable Stripe customer record
  // (one per User, created lazily on first Checkout). subscriptionStatus
  // mirrors Stripe values — "trialing" | "active" | "past_due" | "canceled"
  // | "incomplete" | "incomplete_expired" | "unpaid" — plus our own
  // "comped" value for beta clients who get the app free for life.
  stripeCustomerId             String?   @unique
  subscriptionStatus           String?
  subscriptionCurrentPeriodEnd DateTime?

  profile           Profile?
  mealLogs          MealLog[]
  dailyTotals       DailyTotals[]
  weeklyCheckIns    WeeklyCheckIn[]
  contentSubmissions ContentSubmission[]
  chatMessages      ChatMessage[]      @relation("ChatRecipient")
  sentChatMessages  ChatMessage[]      @relation("ChatSender")
  pushSubscriptions PushSubscription[]
  cheersReceived   CheerReaction[]    @relation("CheersReceived")
  cheersSent       CheerReaction[]    @relation("CheersSent")
}

model Profile {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  age                 Int
  heightInches        Float
  startWeight         Float
  goalWeight          Float
  currentWeight       Float
  activityLevel       ActivityLevel
  cycleStatus         CycleStatus
  phase               Phase         @default(PHASE_1)

  // Calculated targets (Mifflin-St Jeor + RIVEN protocol)
  maintenanceCalories Int
  cutCalories         Int
  weeklyBudget        Int
  proteinFloor        Int

  onboardedAt         DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Post-profile tutorial walkthrough. 0–4 = currently on that slide,
  // 5+ = completed (or skipped). Default 5 so existing rows from before
  // this column existed don't get marched through the tutorial; new
  // profile rows from onboarding/actions.ts explicitly set tutorialStep: 0.
  tutorialStep        Int           @default(5)

  // Duolingo-style streak protection. Each client starts with one freeze;
  // when she misses a day mid-streak the engine can spend a freeze to keep
  // the streak alive instead of resetting it to zero. v1 of this feature
  // ships the foundation (column + UI visibility); the auto-spend logic
  // in sean-messages lands in a follow-up so the behavior can be tested
  // in isolation before going live on the cron path.
  streakFreezesAvailable Int        @default(1)

  // Per-day-of-week calorie schedule. NULL = use the flat cutCalories
  // for every day (default behavior for almost every client). When set,
  // shape is { Sun, Mon, Tue, Wed, Thu, Fri, Sat → number }, keyed by
  // Central-time day-of-week label. Used for calorie-cycling protocols
  // (rest / lift / refeed days) on advanced clients like Rora. The
  // helper in src/lib/calorie-schedule.ts handles parse + fallback.
  dailyCalorieSchedule   Json?
}

// Peer-to-peer cheer reactions. When a client is having a hard day (no log
// 24h+, streak broken, way-over target), other clients see a soft prompt
// to send her a 🌹. Schema is open-ended so we can add more reaction types
// later (today: ROSE only). The unique constraint on (recipient, sender,
// context) prevents a sender from spamming the same trigger.
model CheerReaction {
  id              String   @id @default(cuid())
  recipientUserId String
  recipient       User     @relation("CheersReceived", fields: [recipientUserId], references: [id], onDelete: Cascade)
  senderUserId    String
  sender          User     @relation("CheersSent",     fields: [senderUserId],    references: [id], onDelete: Cascade)
  // "no_log_24h" | "broke_streak" | "way_over_target" | "manual"
  context         String
  createdAt       DateTime @default(now())

  @@unique([recipientUserId, senderUserId, context])
  @@index([recipientUserId, createdAt])
  @@index([senderUserId])
}

model MealLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  description String
  // 3-5 word AI-generated label for compact display ("Eggs, bacon, toast").
  // Nullable for legacy rows logged before this field existed; new rows always
  // get one from Claude's structured output.
  shortName   String?
  calories    Int
  protein     Int
  fat         Int
  carbs       Int
  aiResponse  String   @db.Text

  // AI-extracted per-item breakdown. Each item is { name, calories, protein,
  // fat, carbs }. Lets the UI render individual food chips (Big Mac, fries,
  // chips) instead of forcing the whole combo as a single tappable unit.
  // Nullable for legacy rows; new logs always include at least one item.
  items       Json?

  // Heads-up flag for ultra-processed / refined / seed-oil / sugary content.
  // The "why" is in flagReason — surfaced in the response card to teach,
  // not preach.
  processedFlag Boolean @default(false)
  flagReason    String? @db.Text

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model DailyTotals {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime @db.Date
  totalCalories Int      @default(0)
  totalProtein  Int      @default(0)
  totalFat      Int      @default(0)
  totalCarbs    Int      @default(0)
  totalSteps    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model WeeklyCheckIn {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart         DateTime       @db.Date
  weight            Float
  waist             Float
  photoFrontUrl     String?
  photoSideUrl      String?
  menuAdherence     MenuAdherence
  sleepAvg          Float
  cycleStatus       CheckInCycle
  stress            Int
  winsAndStruggles  String         @db.Text

  createdAt         DateTime       @default(now())

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model ContentSubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  week       DateTime @db.Date
  promptText String
  videoUrl   String?
  photoUrl   String?

  createdAt  DateTime @default(now())

  @@index([userId, week])
}

model ChatMessage {
  id        String   @id @default(cuid())

  // Whose chat thread this message belongs to (always the client).
  userId    String
  user      User     @relation("ChatRecipient", fields: [userId], references: [id], onDelete: Cascade)

  role      ChatRole
  // AI = generated by Claude. COACH = written by Sean from the coach dashboard.
  // USER messages are always AI-bound (the client typing into the AI chat).
  kind      ChatMessageKind @default(AI)

  // Only set for kind = COACH messages — Sean's User.id.
  senderUserId String?
  sender       User?   @relation("ChatSender", fields: [senderUserId], references: [id])

  content   String   @db.Text
  // Public R2 URLs for images attached to USER messages, passed to Claude vision.
  imageUrls String[] @default([])

  // Proactive-messaging category. Null for normal chat / hand-written coach
  // messages. Set to a category string like "rhythm_wed_pm" or
  // "behavioral_24h" when the Sean-messages tick fires a templated nudge.
  // Used for cooldown enforcement (same category can't fire twice in 48h)
  // and daily-cap counting (max 3 proactive sends per client per day).
  category  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([senderUserId])
  @@index([userId, category, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Web Push API fields. The endpoint is unique per browser+device.
  endpoint  String   @unique
  p256dh    String   // base64url-encoded ECDH public key
  auth      String   // base64url-encoded auth secret
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Lead from the /quiz funnel. Captured before sign-up — we hold the
// answers + computed score + Q14 budget tier so the results page can
// route to the right CTA and Sean can email/segment leads later.
// convertedToUserId is loosely linked (no FK relation) so deleting a
// User doesn't cascade and lose marketing history.
model Lead {
  id                String   @id @default(cuid())

  // Captured on the contact step before questions start.
  firstName         String
  email             String
  phone             String?

  // Auto-captured at submit time.
  ipAddress         String?
  country           String?

  // Full answer set. Shape: Record<string, string | string[] | boolean>
  // Keyed by question id (q1..q15). q1–q10 are "yes"/"no", q11–q14 are
  // option keys, q15 is free text. Schema enforced by zod at the API edge.
  answers           Json

  // Derived once at submit. Stored so the results page doesn't recompute
  // and Sean can sort/filter the dashboard later without re-scoring.
  score             Int      // 0–10, count of "yes" in q1–q10
  budgetTier        String   // FREE | APP | COACH | DONE_FOR_YOU — from q14

  // If she later signs up, we stamp her User.id here so Sean can see
  // who converted. Plain String (no FK) on purpose — see model comment.
  convertedToUserId String?

  createdAt         DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([budgetTier, score])
}
