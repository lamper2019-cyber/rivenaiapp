# ──────────────────────────────────────────────────────────────────
# Database (Railway Postgres)
# Get this from your Railway project → Postgres plugin → Variables tab.
# Use DATABASE_PUBLIC_URL when connecting from your laptop, not DATABASE_URL.
# Lives in `.env` (Prisma CLI requirement), NOT in this file. Both are gitignored.
# ──────────────────────────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres:password@viaduct.proxy.rlwy.net:PORT/railway"

# ──────────────────────────────────────────────────────────────────
# Clerk authentication — clerk.com → your app → API Keys
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# ──────────────────────────────────────────────────────────────────
# Anthropic Claude API — server-side only, never expose
# console.anthropic.com → API Keys
# ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ──────────────────────────────────────────────────────────────────
# OpenAI Whisper — voice memo transcription
# platform.openai.com → API Keys
# ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ──────────────────────────────────────────────────────────────────
# Cloudflare R2 — photo and video uploads
# dash.cloudflare.com → R2 Object Storage → API Tokens
# ──────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="riven-app"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# ──────────────────────────────────────────────────────────────────
# Web Push notifications (VAPID keys)
# Generate once with: npx web-push generate-vapid-keys
# Public key is exposed to the client. Private key signs push payloads.
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Random string protecting the Sunday-reminder cron endpoint.
# Hit that endpoint as: curl -H "Authorization: Bearer $CRON_SECRET" .../api/cron/sunday-reminder
CRON_SECRET="generate-a-random-string-here"

# ──────────────────────────────────────────────────────────────────
# Coach role — comma-separated emails auto-promoted to role=COACH
# Set to Sean's email once he signs up.
# ──────────────────────────────────────────────────────────────────
COACH_EMAIL=""

# ──────────────────────────────────────────────────────────────────
# Plausible Analytics — privacy-friendly pageview / event tracking.
# Set to your verified site domain in Plausible (e.g. "rivenmethod.com").
# When unset, the tracker silently no-ops — safe for forks and dev.
# Vercel: add as NEXT_PUBLIC_PLAUSIBLE_DOMAIN in project env vars.
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ──────────────────────────────────────────────────────────────────
# PostHog — product analytics, session replay, feature flags.
# Set NEXT_PUBLIC_POSTHOG_KEY to the project's public API key (phc_...).
# NEXT_PUBLIC_POSTHOG_HOST defaults to us.i.posthog.com if unset; set
# to https://eu.i.posthog.com for the EU region or your own reverse
# proxy. Session replay is OFF by default — flip
# NEXT_PUBLIC_POSTHOG_REPLAY=1 to turn it on (heavier on quota).
# When the key is unset, the tracker silently no-ops.
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_POSTHOG_REPLAY=""

# ──────────────────────────────────────────────────────────────────
# CONTENT COMMAND CENTER (/coach/insights)
# Joins Instagram performance to the RIVEN funnel. All server-side.
# ──────────────────────────────────────────────────────────────────
# PostHog server-side query (the FUNNEL half). This is a *Personal API
# key* (phx_...), NOT the public phc_ write key above. Read-only is fine.
# PostHog → Settings → Personal API keys → create, scope: "Query Read".
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID="448237"
# Optional; defaults to https://us.posthog.com
POSTHOG_API_HOST=""

# Instagram API with Instagram Login (the CONTENT half) — reads Sean's own
# @itsseanwilliams account directly. NO Facebook Page, NO app secret needed.
# Setup: Meta app → Instagram → "API setup with Instagram business login" →
# add the IG account as an Instagram Tester → Generate token. The token is
# long-lived (60 days) and the daily cron auto-refreshes it (ig_refresh_token,
# no secret). This single var is all that's required.
INSTAGRAM_ACCESS_TOKEN=""
